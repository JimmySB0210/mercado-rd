# ═══════════════════════════════════════════════════════════
# MercadoRD — Variables de entorno
# Copia este archivo como: .env.local
# NUNCA subas .env.local al repositorio de GitHub
# ═══════════════════════════════════════════════════════════

# ─── Supabase ───────────────────────────────────────────────
# Consíguelas en: https://app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Azul (procesador de pagos RD) ──────────────────────────
# Solicítalo en: https://azul.com.do/desarrolladores
AZUL_STORE_ID=MRD001
AZUL_AUTH1=tu_auth1_key
AZUL_AUTH2=tu_auth2_key
AZUL_AUTH_KEY=tu_hmac_key

# ─── WhatsApp Business API (Meta) ───────────────────────────
# Configura en: https://developers.facebook.com
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxx
WHATSAPP_PHONE_ID=1234567890
WHATSAPP_VERIFY_TOKEN=mercadord_webhook_secret

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MercadoRD
